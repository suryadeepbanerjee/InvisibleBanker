# LLM — Primary
GROQ_API_KEY=your_groq_api_key_here

# LLM — Fallback (use ONLY after Groq failure/rate-limit — NOT as primary)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice STT — Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v4

# Web Crawling (knowledge pre-ingestion ONLY — not in live request path)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# WARNING: SERVICE_ROLE_KEY is BACKEND ONLY — NEVER expose to frontend/browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App Configuration
CONFIDENCE_THRESHOLD=0.75
MAX_LLM_RETRIES=3
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
